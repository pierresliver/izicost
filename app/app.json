{
  "expo": {
    "name": "IziCost",
    "slug": "izicost",
    "version": "0.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "izicost",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pierresliver2026.izicost"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6E4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pierresliver2026.izicost",
      "versionCode": 4
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B6E4F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "IziCost uses the camera to scan your receipts.",
          "photosPermission": "IziCost needs your photos to import a receipt picture."
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IziCost uses your location to show prices near you and to remember which shop branch you visited. It is never shared."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "IziCost uses the camera to scan your receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "IziCost uses the microphone so you can say your shopping list instead of typing it.",
          "speechRecognitionPermission": "IziCost uses speech recognition to turn what you say into a shopping list."
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
